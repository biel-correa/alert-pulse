# Multi-stage Dockerfile for AWS Lambda Container (.NET 10 WebhookMonitor)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files and restore dependencies
COPY ["backend/src/WebhookMonitor/WebhookMonitor.csproj", "backend/src/WebhookMonitor/"]
RUN dotnet restore "backend/src/WebhookMonitor/WebhookMonitor.csproj"

# Copy source code and build release binary
COPY backend/ backend/
WORKDIR "/src/backend/src/WebhookMonitor"
RUN dotnet publish "WebhookMonitor.csproj" -c Release -o /app/publish \
    /p:UseAppHost=false

# Lambda base image or custom runtime
FROM public.ecr.aws/lambda/dotnet:8 AS lambda-base

# We can also use alpine with AWS Lambda Runtime Interface Client or public.ecr.aws/lambda/provided:al2023
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /var/task

# Install Lambda RIC dependencies if needed or use entrypoint
COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production \
    AWS_LAMBDA_HANDLER_LOG_LEVEL=Information

ENTRYPOINT ["dotnet", "WebhookMonitor.dll"]

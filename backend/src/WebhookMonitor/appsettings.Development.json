{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "ServiceURL": "http://localhost:4566",
    "UseLocalStack": true,
    "DynamoDbTable": "MonitoringHub",
    "SnsAlertTopicArn": "arn:aws:sns:us-east-1:000000000000:WebhookCriticalAlerts"
  }
}
